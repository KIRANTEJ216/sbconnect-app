rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Users: read anyone authenticated, update self or admin, no deletes
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && (request.auth.uid == userId || isAdmin());
      allow delete: if false;
    }

    // Profiles: read anyone authenticated, create/update own (can't set verified), no deletes
    // Locked profiles block client-side edits unless admin
    match /profiles/{profileId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == profileId
        && request.resource.data.verified == false;
      allow update: if request.auth != null
        && request.auth.uid == profileId
        && (isAdmin() || resource.data.locked != true)
        && (!request.resource.data.keys().hasAny(['verified'])
            || request.resource.data.verified == resource.data.verified);
      allow delete: if false;
    }

    // Requests: read anyone authenticated, create authenticated (must match uid), update own, no deletes
    match /requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if false;

      // Interests subcollection: any authenticated can read/create, owner can read
      match /interests/{interestId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if false;
        allow delete: if false;
      }
    }

    // Deals: read anyone authenticated, create only system (no client creates), no deletes
    match /deals/{dealId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }

    // Conversations: only participants can read/update, no deletes
    match /conversations/{convId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if false;

      // Messages: only conversation participants can read/create, sender can update, no deletes
      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid;
        allow update: if request.auth != null && request.auth.uid == resource.data.senderId;
        allow delete: if false;
      }
    }
  }
}
