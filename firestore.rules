rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'super_admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isAdminOrSuperAdmin() {
      return request.auth != null && (
        request.auth.token.role in ['admin', 'super_admin'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'])
      );
    }

    // Fields a member may never assert on a deal at creation time. Each one
    // would let a submitter influence a figure or an attribution the rules
    // cannot verify:
    //   reviewedBy / reviewedAt — forge a completed review trail
    //   reviewNote               — forge a reviewer's stated reason
    //   occurredOn               — choose the fiscal-year bucket, since
    //                              revenueStats.ts:45 falls back to it
    //   referrerUid / giverUid   — divert referral credit to any member;
    //                              submitReferralRevenue derives these from
    //                              the profile, but rules cannot re-derive it
    //
    // Declared as a helper rather than inlined in the create rule: a line
    // beginning with '!' directly after the preceding rule's comment block
    // fails to parse ("Unexpected '!'"), so the negations cannot lead a line
    // in that position.
    function memberDealFieldsPinned() {
      return !('reviewedBy' in request.resource.data)
        && !('reviewedAt' in request.resource.data)
        && !('reviewNote' in request.resource.data)
        && !('occurredOn' in request.resource.data)
        && !('referrerUid' in request.resource.data)
        && !('giverUid' in request.resource.data);
    }

    // Users: owner can read/write own doc; admin/super_admin can read all; super_admin can write all
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdminOrSuperAdmin());
      allow write: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
    }

    // Profiles: authenticated read; owner create/update; super_admin full access
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Requests: authenticated read/create; owner update; super_admin full access
    match /requests/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.uid || isSuperAdmin());
      allow delete: if isSuperAdmin();

      match /interests/{interest} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if isSuperAdmin();
      }
    }

    // Meetings: authenticated read; super_admin write
    match /meetings/{id} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();

      match /rsvps/{rsvp} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null && request.auth.uid == resource.data.uid;
        allow delete: if isSuperAdmin();
      }
    }

    // Attendance: authenticated read/create; super_admin update/delete
    match /attendance/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin();
    }

    // Deals: authenticated read/create; super_admin update/delete.
    // A member may submit their own revenue but must never self-approve it: the
    // only way a doc can land already-approved is via an admin session.
    match /deals/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && (
          isAdminOrSuperAdmin()
          || (
            request.resource.data.receiverUid == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.submittedByRole == 'member'
            && memberDealFieldsPinned()
          )
        );
      // Super admin only, on purpose: approval stays with kktej3d, and deletion
      // of ledger records is not part of approving anything.
      //
      // Diff-validated so approval cannot be used as a backdoor to rewrite the
      // ledger. reviewRevenueEntry (:566) writes only status, reviewedBy,
      // reviewedAt, reviewNote and updatedAt, so every field protected here is
      // one that a legitimate review never touches. Without this, an approved
      // deal's amountValue could be edited after the fact, silently restating
      // revenue on the leaderboard and the headline total.
      allow update: if isSuperAdmin()
        && (
          // Reopening a decided entry is never allowed: the stats transaction in
          // reviewRevenueEntry only moves value INTO the total, so flipping an
          // approved or rejected deal back to pending would double-count.
          resource.data.status == 'pending'
          || request.resource.data.status == resource.data.status
        )
        // get() rather than a bare field read: a PATCH with an updateMask only
        // presents the masked fields on request.resource, so reading an unmasked
        // one raises "Property X is undefined on object" and denies the whole
        // update. get().data.<field> yields null for an absent field, which
        // compares equal to itself and lets the update through.
        && request.resource.data.get('amountValue', null) == resource.data.get('amountValue', null)
        && request.resource.data.get('receiverUid', null) == resource.data.get('receiverUid', null)
        && request.resource.data.get('giverUid', null) == resource.data.get('giverUid', null)
        && request.resource.data.get('source', null) == resource.data.get('source', null)
        && request.resource.data.get('referrerUid', null) == resource.data.get('referrerUid', null)
        && request.resource.data.get('referredMemberUid', null) == resource.data.get('referredMemberUid', null)
        && request.resource.data.get('occurredOn', null) == resource.data.get('occurredOn', null)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('submittedBy', null) == resource.data.get('submittedBy', null);
      allow delete: if isSuperAdmin();
    }

    // Materialized revenue aggregates (functions/src/revenueStats.ts).
    // Read-only for members: these are derived numbers, never a source of truth,
    // so a member must not be able to inflate the headline by writing here.
    match /revenueStats/{fy} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Per-member referral revenue, a subcollection of the member's own user doc.
    // The Cloud Function mirrors deal writes here; members can read their own.
    match /users/{uid}/revenueEntries/{entryId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Per-member RSVP mirror of meetings/{id}/rsvps. The member writes their own
    // RSVPs (that is the whole point) but can only ever write their own subtree,
    // so a member cannot answer on someone else's behalf.
    match /users/{uid}/rsvps/{meetingId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Issue Reports: owner read+reply; super_admin full; admin read-only
    match /issueReports/{id} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || isAdminOrSuperAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Notifications: authenticated read; super_admin write
    match /notifications/{id} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // Conversations: participants read/write; super_admin delete
    match /conversations/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if isSuperAdmin();

      match /messages/{message} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participants;
        allow create: if request.auth != null;
        allow update: if request.auth != null && request.auth.uid == resource.data.senderId;
        allow delete: if isSuperAdmin();
      }
    }

    // Settings: any authenticated read (revenue target is public to members); super_admin write
    match /settings/{key} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // Stats: authenticated read. Only admins may write the revenue aggregates —
    // `stats/online` stays client-writable because online counting happens on
    // every login/logout from the client.
    match /stats/{key} {
      allow read: if request.auth != null;
      allow write: if isAdminOrSuperAdmin()
        || (key == 'online' && request.auth != null);
    }

    // Login logs: admin/super_admin read; any authenticated create; super_admin update/delete
    match /loginLogs/{id} {
      allow read: if isAdminOrSuperAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin();
    }

    // User Notifications: owner read/update; super_admin create/delete
    match /userNotifications/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if isSuperAdmin();
      allow update: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if isSuperAdmin();
    }

    // Config: admin/super_admin read; super_admin write
    match /config/{key} {
      allow read: if isAdminOrSuperAdmin();
      allow write: if isSuperAdmin();
    }
  }
}
