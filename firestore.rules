rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'super_admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isAdminOrSuperAdmin() {
      return request.auth != null && (
        request.auth.token.role in ['admin', 'super_admin'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'])
      );
    }

    // Users: owner can read/write own doc; admin/super_admin can read all; super_admin can write all
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdminOrSuperAdmin());
      allow write: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
    }

    // Profiles: authenticated read; owner create/update; super_admin full access
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Requests: authenticated read/create; owner update; super_admin full access
    match /requests/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.uid || isSuperAdmin());
      allow delete: if isSuperAdmin();

      match /interests/{interest} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if isSuperAdmin();
      }
    }

    // Meetings: authenticated read; super_admin write
    match /meetings/{id} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();

      match /rsvps/{rsvp} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null && request.auth.uid == resource.data.uid;
        allow delete: if isSuperAdmin();
      }
    }

    // Attendance: authenticated read/create; super_admin update/delete
    match /attendance/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin();
    }

    // Deals: authenticated read/create; super_admin update/delete
    match /deals/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin();
    }

    // Issue Reports: owner read+reply; super_admin full; admin read-only
    match /issueReports/{id} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || isAdminOrSuperAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Notifications: authenticated read; super_admin write
    match /notifications/{id} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // Conversations: participants read/write; super_admin delete
    match /conversations/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if isSuperAdmin();

      match /messages/{message} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(id)).data.participants;
        allow create: if request.auth != null;
        allow update: if request.auth != null && request.auth.uid == resource.data.senderId;
        allow delete: if isSuperAdmin();
      }
    }

    // Settings: any authenticated read (revenue target is public to members); super_admin write
    match /settings/{key} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // Stats: authenticated read; admin/super_admin write (online counting)
    match /stats/{key} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdminOrSuperAdmin();
    }

    // Login logs: admin/super_admin read; any authenticated create; super_admin update/delete
    match /loginLogs/{id} {
      allow read: if isAdminOrSuperAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin();
    }

    // User Notifications: owner read/update; super_admin create/delete
    match /userNotifications/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if isSuperAdmin();
      allow update: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if isSuperAdmin();
    }

    // Config: admin/super_admin read; super_admin write
    match /config/{key} {
      allow read: if isAdminOrSuperAdmin();
      allow write: if isSuperAdmin();
    }
  }
}