rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: owner can read/write own doc; admins can read all
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
    }

    // Profiles: authenticated users can read all; owner can write; admins can write
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || request.auth.token.role in ['admin', 'super_admin']);
      allow delete: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
    }

    // Requests: authenticated can read all; owner can write
    match /requests/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.uid || request.auth.token.role in ['admin', 'super_admin']);
      allow delete: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];

      match /interests/{interest} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
      }
    }

    // Meetings: admins can write; authenticated can read
    match /meetings/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];

      match /rsvps/{rsvp} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null && request.auth.uid == resource.data.uid;
        allow delete: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
      }
    }

    // Attendance: authenticated can read/create
    match /attendance/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
    }

    // Deals: authenticated can read/create
    match /deals/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
    }

    // Issue Reports: any authenticated can create; admins can read/resolve/delete
    match /issueReports/{id} {
      allow read: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
      allow delete: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
    }

    // Notifications: authenticated can read; admins can write
    match /notifications/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
    }

    // Conversations & messages: participants can read/write
    match /conversations/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];

      match /messages/{message} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null && request.auth.uid == resource.data.senderId;
        allow delete: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
      }
    }

    // Login logs: admins can read/create
    match /loginLogs/{id} {
      allow read: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
    }

    // Config: admins can read/write (used for webhook URL, app settings)
    match /config/{key} {
      allow read: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
      allow write: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
    }
  }
}
