rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.email == 'kktej3d@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isAdminOrSuperAdmin() {
      return request.auth != null && (
        request.auth.token.role in ['admin', 'super_admin'] ||
        request.auth.token.email == 'kktej3d@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'])
      );
    }

    // Users: owner can write; super_admin full access; admin read-only
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdminOrSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Profiles: authenticated read; owner/create/update; super_admin full access; admin read-only
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Requests: authenticated read/create; owner update; super_admin full access
    match /requests/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.uid || isSuperAdmin());
      allow delete: if isSuperAdmin();

      match /interests/{interest} {
        allow read: if request.auth != null && (request.auth.uid == get(/databases/$(database)/documents/requests/$(id)).data.uid || isSuperAdmin());
        allow create: if request.auth != null;
        allow update, delete: if isSuperAdmin();
      }
    }

    // Meetings: authenticated read; super_admin write; admin read-only
    match /meetings/{id} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();

      match /rsvps/{rsvp} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null && request.auth.uid == resource.data.uid;
        allow delete: if isSuperAdmin();
      }
    }

    // Attendance: authenticated read/create; super_admin update/delete
    match /attendance/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin();
    }

    // Deals: authenticated read/create; super_admin update/delete
    match /deals/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin();
    }

    // Issue Reports: owner read+reply; super_admin full; admin read-only
    match /issueReports/{id} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || isAdminOrSuperAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.uid || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Notifications: authenticated read; super_admin write; admin read-only
    match /notifications/{id} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin();
    }

    // Conversations: participants read/write; super_admin delete
    match /conversations/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if isSuperAdmin();

      match /messages/{message} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null && request.auth.uid == resource.data.senderId;
        allow delete: if isSuperAdmin();
      }
    }

    // Login logs: super_admin read/create; admin read-only
    match /loginLogs/{id} {
      allow read: if isAdminOrSuperAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin();
    }

    // User Notifications: owner read/update; super_admin create/delete
    match /userNotifications/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if isSuperAdmin();
      allow update: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if isSuperAdmin();
    }

    // Config: super_admin read/write
    match /config/{key} {
      allow read: if isAdminOrSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Health checks: super_admin only (triggered from Admin Reports tab)
    match /_health/{docId} {
      allow read, write, delete: if isSuperAdmin();
    }
  }
}
