rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: owner can write; super_admin full access; admin read-only
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
      allow write: if request.auth != null && request.auth.token.role == 'super_admin';
    }

    // Profiles: authenticated read; owner/create/update; super_admin full access; admin read-only
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || request.auth.token.role == 'super_admin');
      allow delete: if request.auth != null && request.auth.token.role == 'super_admin';
    }

    // Requests: authenticated read/create; owner update; super_admin full access
    match /requests/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.uid || request.auth.token.role == 'super_admin');
      allow delete: if request.auth != null && request.auth.token.role == 'super_admin';

      match /interests/{interest} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.token.role == 'super_admin';
      }
    }

    // Meetings: authenticated read; super_admin write; admin read-only
    match /meetings/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'super_admin';

      match /rsvps/{rsvp} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null && request.auth.uid == resource.data.uid;
        allow delete: if request.auth != null && request.auth.token.role == 'super_admin';
      }
    }

    // Attendance: authenticated read/create; super_admin update/delete
    match /attendance/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.role == 'super_admin';
    }

    // Deals: authenticated read/create; super_admin update/delete
    match /deals/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.role == 'super_admin';
    }

    // Issue Reports: owner read+reply; super_admin full; admin read-only
    match /issueReports/{id} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.uid || request.auth.token.role in ['admin', 'super_admin']);
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.uid || request.auth.token.role == 'super_admin');
      allow delete: if request.auth != null && request.auth.token.role == 'super_admin';
    }

    // Notifications: authenticated read; super_admin write; admin read-only
    match /notifications/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'super_admin';
    }

    // Conversations: participants read/write; super_admin delete
    match /conversations/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
      allow delete: if request.auth != null && request.auth.token.role == 'super_admin';

      match /messages/{message} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null && request.auth.uid == resource.data.senderId;
        allow delete: if request.auth != null && request.auth.token.role == 'super_admin';
      }
    }

    // Login logs: super_admin read/create; admin read-only
    match /loginLogs/{id} {
      allow read: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.role == 'super_admin';
    }

    // User Notifications: owner read/update; super_admin create/delete
    match /userNotifications/{id} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.token.role == 'super_admin';
      allow update: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if request.auth != null && request.auth.token.role == 'super_admin';
    }

    // Config: super_admin read/write
    match /config/{key} {
      allow read: if request.auth != null && request.auth.token.role in ['admin', 'super_admin'];
      allow write: if request.auth != null && request.auth.token.role == 'super_admin';
    }
  }
}
